// ============================================================
// NEXT MOVE JAPAN 学生イベント基盤 — Prisma schema（ドラフト）
// 要件定義 v0.4 §5 ＋ プロトタイプ画面から追加で必要になったもの
// 2026-10-08 定例の決定を反映（支払い待ち・補欠の廃止、枠の種類、QR チケットと受付状態、保存、権限 admin/owner/user ほか）
// DB: PostgreSQL
// ※ Prisma で書けない制約（CHECK・部分一意インデックス）は末尾の SQL をマイグレーションに追記する
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- enums ----------
enum OrganizerType {
  USER
  GROUP
}

// サイト全体の権限。ADMIN = NMJ 運営
enum UserRole {
  USER
  ADMIN
}

// 団体の権限は owner のみ（複数可）。将来ロールを増やす余地として enum のまま残す
enum MemberRole {
  OWNER
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
}

enum VenueType {
  OFFLINE
  ONLINE
}

enum AttendeeListVisibility {
  ORGANIZER_ONLY // 既定
  PUBLIC_NICKNAME // 参加者のあだ名を公開
}

// 支払い待ち・補欠は持たない。有料枠は決済完了の Webhook で初めて CONFIRMED の行を作る
enum RegistrationStatus {
  CONFIRMED // 参加予定
  CANCELLED
}

// 参加枠の種類（絞り込みに使う）
enum SlotKind {
  STUDENT // 学生
  ADULT // 大人
  PARTY // 懇親会
  OTHER
}

// 受付の状態（いつでも戻せる）
enum CheckinStatus {
  NOT_CHECKED_IN // 未受付
  CHECKED_IN // 受付済
  ABSENT // 欠席
}

enum CheckinMethod {
  QR
  MANUAL // 参加者リストから変更
}

enum QuestionType {
  TEXT
  TEXTAREA
  TEL
  SELECT
  MULTI_SELECT
}

enum PaymentProvider {
  MOCK
  STRIPE
}

enum PaymentStatus {
  PENDING // 決済画面にいる間。holdExpiresAt まで席を確保する
  PAID
  FAILED
  EXPIRED // 確保の期限切れ（席を解放）
  REFUNDED
}

enum AnnouncementAudience {
  ATTENDEES // 参加予定の人
  SAVED // イベントを保存した人（未申込）
}

enum ReportTargetType {
  EVENT
  ORGANIZER
}

enum ReportReason {
  FRAUD // 詐欺・架空のイベント
  INAPPROPRIATE // 不適切な内容
  PERSONAL_DATA_ABUSE // 個人情報の不正な収集
  OTHER
}

enum ArticleStatus {
  DRAFT
  IN_REVIEW // 主催者投稿は運営の審査待ち
  PUBLISHED
  REJECTED
}

enum NotificationType {
  REGISTRATION_CONFIRMED // 申込完了（QR チケットを載せる）
  EVENT_CANCELLED // 中止
  NEW_EVENT_FROM_FOLLOWING // フォロー先の新規公開
  ANNOUNCEMENT // 主催者からの告知
  ANSWER_DELETION_NOTICE // 回答削除の7日前予告（主催者宛て）
  INVITATION // メンバー招待
  JOIN_REQUEST // 既存の団体への参加依頼（owner 宛て）
  REPORT_RECEIVED // 通報の受付（NMJ 運営宛て）
}

enum EmailCategory {
  EVENT_UPDATES // 申込・QR チケット・中止（取引メール）
  FOLLOW_NEWS // フォロー先の新規公開
  ANNOUNCEMENTS // 主催者からのお知らせ（参加予定の人・保存した人）
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  SUPPRESSED // 配信停止により送らなかった
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

// ---------- マスタ ----------
// 10/8 で大学の絞り込みはなくした。Event.targetUniversityId を残すかは未決
model University {
  id          String  @id @default(cuid())
  name        String
  slug        String  @unique
  emailDomain String? // 将来の自動判定用に持つだけ
  events      Event[]
}

// ジャンル（絞り込み用。運営が管理）
model Genre {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  sortOrder Int     @default(0)
  events    Event[]
}

// ---------- アカウント ----------
// 認証と通知のための最小限。表示に関わる情報は Organizer（type=USER）が持つ。本名・大学は持たない
model User {
  id        String   @id @default(cuid())
  googleSub String   @unique
  email     String   @unique
  role      UserRole @default(USER) // ADMIN = NMJ 運営（記事の審査・通報の対応・団体の統合と削除）
  createdAt DateTime @default(now())

  organizer           Organizer?         @relation("PersonalOrganizer")
  memberships         OrganizerMember[]
  follows             Follow[]
  savedEvents         SavedEvent[]
  registrations       Registration[]
  tickets             Ticket[]
  payments            Payment[]
  checkinLogs         CheckinLog[]
  joinRequests        GroupJoinRequest[]
  joinRequestsDecided GroupJoinRequest[] @relation("JoinRequestDecidedBy")
  invitationsCreated  Invitation[]       @relation("InvitationCreatedBy")
  invitationsAccepted Invitation[]       @relation("InvitationAcceptedBy")
  exportLogs          AnswerExportLog[]
  reports             Report[]
  reportsResolved     Report[]           @relation("ReportResolvedBy")
  articlesWritten     MediaArticle[]     @relation("ArticleAuthor")
  articlesReviewed    MediaArticle[]     @relation("ArticleReviewer")
  notifications       NotificationLog[]
  emailPreferences    EmailPreference[]

  // Auth.js（Prisma アダプタ）
  accounts Account[]
  sessions Session[]
}

// 主催者アカウント（団体・個人を1つに閉じ込める）。/@slug の実体
model Organizer {
  id          String        @id @default(cuid())
  type        OrganizerType
  userId      String?       @unique // type=USER のときのみ非 NULL（CHECK は末尾 SQL）
  slug        String        @unique // ユーザーネーム。予約語はアプリ側で拒否
  displayName String // あだ名（重複可・日本語可）
  iconUrl     String?
  bio         String? // 団体のみ UI で使う
  coverUrl    String? // 団体のみ UI で使う
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user             User?                   @relation("PersonalOrganizer", fields: [userId], references: [id])
  members          OrganizerMember[]
  socialLinks      SocialLink[]
  followers        Follow[]
  events           Event[]
  payoutAccounts   PayoutAccount[]
  invitations      Invitation[]
  joinRequests     GroupJoinRequest[]
  articleLinks     MediaArticleOrganizer[]
  articlesAuthored MediaArticle[]          @relation("ArticleAuthorOrganizer")
}

// 運営メンバー（type=GROUP の Organizer にのみ作成。owner は複数可。最後の owner は離脱不可 → アプリのトランザクションで検証）
// 団体の作成に申請はない。削除・引き継ぎの扱いは未決（削除は NMJ 運営が行う想定）
model OrganizerMember {
  organizerId String
  userId      String
  role        MemberRole
  invitedAt   DateTime   @default(now())
  joinedAt    DateTime?

  organizer Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([organizerId, userId])
  @@index([userId])
}

// 招待リンク（メンバー招待モーダル）
model Invitation {
  id           String     @id @default(cuid())
  organizerId  String
  role         MemberRole @default(OWNER)
  token        String     @unique
  expiresAt    DateTime
  createdById  String
  acceptedById String?
  acceptedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime   @default(now())

  organizer  Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  createdBy  User      @relation("InvitationCreatedBy", fields: [createdById], references: [id])
  acceptedBy User?     @relation("InvitationAcceptedBy", fields: [acceptedById], references: [id])

  @@index([organizerId])
}

// 既存の団体への参加依頼（団体作成時に似た名前の団体が見つかったときの導線。同じ団体のページが増えるのを防ぐ）
model GroupJoinRequest {
  id          String            @id @default(cuid())
  organizerId String
  userId      String
  message     String?
  status      JoinRequestStatus @default(PENDING)
  decidedById String?
  decidedAt   DateTime?
  createdAt   DateTime          @default(now())

  organizer Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User?     @relation("JoinRequestDecidedBy", fields: [decidedById], references: [id])

  @@index([organizerId, status])
}

model SocialLink {
  id          String @id @default(cuid())
  organizerId String
  platform    String // X / Instagram / GitHub など（本人確認はしない）
  url         String
  sortOrder   Int    @default(0)

  organizer Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([organizerId, sortOrder])
}

// フォローできるのは type=GROUP の主催者だけ（アプリで検証）
model Follow {
  userId      String
  organizerId String
  notifyEmail Boolean  @default(true) // 新規公開のメール通知 ON/OFF
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizer Organizer @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@id([userId, organizerId])
  @@index([organizerId])
}

// ---------- イベント ----------
model Event {
  id                     String                 @id @default(cuid())
  organizerId            String // 移管はこの付け替えだけ
  targetUniversityId     String? // NULL = 大学を問わない（画面からは外した。残すか未決）
  genreId                String
  area                   String // 都道府県名。オンラインのみは "online"（絞り込み用）
  capacity               Int? // イベント全体の参加者上限。NULL = 枠の定員だけ
  title                  String
  body                   String // Markdown
  startAt                DateTime
  endAt                  DateTime
  venueType              VenueType
  venueName              String?
  address                String?
  onlineUrl              String? // 参加予定の人にのみ開示
  status                 EventStatus            @default(DRAFT)
  publishedAt            DateTime?
  cancelledAt            DateTime?
  cancelReason           String? // 中止時の参加者への説明
  coverUrl               String?
  payoutAccountId        String? // この回の入金先（MVP は未使用）
  attendeeListVisibility AttendeeListVisibility @default(ORGANIZER_ONLY)
  answerRetentionDays    Int                    @default(30) // 30 / 90 / 365（CHECK は末尾 SQL）
  dataUsePurpose         String? // 個人情報の質問があれば公開時に必須（アプリで検証）
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  organizer        Organizer              @relation(fields: [organizerId], references: [id])
  targetUniversity University?            @relation(fields: [targetUniversityId], references: [id])
  genre            Genre                  @relation(fields: [genreId], references: [id])
  payoutAccount    PayoutAccount?         @relation(fields: [payoutAccountId], references: [id])
  slots            Slot[]
  questions        RegistrationQuestion[]
  announcements    Announcement[]
  savedBy          SavedEvent[]
  tickets          Ticket[]
  payments         Payment[]
  exportLogs       AnswerExportLog[]
  articleLinks     MediaArticleEvent[]
  notifications    NotificationLog[]

  @@index([status, startAt])
  @@index([genreId, startAt])
  @@index([area, startAt])
  @@index([organizerId, startAt])
  @@index([endAt]) // 回答の自動削除 Cron
}

// 参加枠。種類・定員・価格は枠の属性
model Slot {
  id          String    @id @default(cuid())
  eventId     String
  kind        SlotKind
  name        String
  description String?
  capacity    Int
  priceYen    Int       @default(0) // 0 = 無料枠
  opensAt     DateTime?
  closesAt    DateTime?
  sortOrder   Int       @default(0)

  event         Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  registrations Registration[]

  @@index([eventId, kind])
}

// 申込（枠ごと）。行があるのは参加予定かキャンセルだけ
// ticketId の Ticket は同じ userId・eventId のものに限る（アプリで検証）
// 定員判定は Slot 行（と全体上限があれば Event 行）を SELECT ... FOR UPDATE してから、CONFIRMED と確保中の Payment を数える（registerToSlot に集約）
model Registration {
  id          String             @id @default(cuid())
  slotId      String
  userId      String
  ticketId    String
  paymentId   String? // 有料枠のときの決済
  status      RegistrationStatus @default(CONFIRMED)
  appliedAt   DateTime           @default(now())
  cancelledAt DateTime?
  note        String?

  slot          Slot                 @relation(fields: [slotId], references: [id])
  user          User                 @relation(fields: [userId], references: [id])
  ticket        Ticket               @relation(fields: [ticketId], references: [id])
  payment       Payment?             @relation(fields: [paymentId], references: [id])
  answers       RegistrationAnswer[]
  notifications NotificationLog[]

  // 同一枠に有効な申込は1件 → 部分一意インデックスを末尾 SQL で作成
  @@index([slotId, status])
  @@index([userId, status])
  @@index([ticketId])
}

// QR チケット（1人1イベント1枚。複数枠でも1枚）。受付の状態もここで持つ
model Ticket {
  id            String        @id @default(cuid())
  eventId       String
  userId        String
  token         String        @unique // QR に載せる推測できない値
  checkinStatus CheckinStatus @default(NOT_CHECKED_IN)
  checkedInAt   DateTime?
  issuedAt      DateTime      @default(now())
  revokedAt     DateTime? // 全枠キャンセルで無効化
  walletPassUrl String? // Apple / Google Wallet（検討中）

  event         Event          @relation(fields: [eventId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  registrations Registration[]
  checkinLogs   CheckinLog[]

  @@unique([eventId, userId])
  @@index([eventId, checkinStatus])
}

// 受付の状態を変えた記録（誰が・いつ・QR かリストか）
model CheckinLog {
  id          String        @id @default(cuid())
  ticketId    String
  fromStatus  CheckinStatus
  toStatus    CheckinStatus
  method      CheckinMethod
  changedById String
  changedAt   DateTime      @default(now())

  ticket    Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  changedBy User   @relation(fields: [changedById], references: [id])

  @@index([ticketId, changedAt])
}

// 申込時の質問。公開後は削除・type 変更禁止（アプリで検証）
// commonKey がある行は全イベント共通の質問（作成時に自動で入り、削除・変更不可）。中身は未決（仮：NAME / KANA / AFFILIATION）
model RegistrationQuestion {
  id             String       @id @default(cuid())
  eventId        String
  commonKey      String?
  label          String
  helpText       String?
  type           QuestionType
  options        Json? // SELECT 系のみ
  required       Boolean      @default(false)
  isPersonalData Boolean      @default(false)
  slotIds        String[] // 空 = 全枠。「懇親会枠のみ」などの対象枠
  sortOrder      Int          @default(0)

  event   Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers RegistrationAnswer[]

  @@index([eventId, sortOrder])
}

// 本名・連絡先はここにだけ存在し、保持期間後に削除される。閲覧は主催者と本人のみ
model RegistrationAnswer {
  registrationId String
  questionId     String
  value          String
  updatedAt      DateTime @updatedAt

  registration Registration         @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  question     RegistrationQuestion @relation(fields: [questionId], references: [id])

  @@id([registrationId, questionId])
}

// CSV 出力の記録（誰がいつ出力したか。§8）
model AnswerExportLog {
  id              String   @id @default(cuid())
  eventId         String
  userId          String
  includeAnswers  Boolean
  includeWaitlist Boolean  @default(false)
  exportedAt      DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  @@index([eventId, exportedAt])
}

// ---------- 決済 ----------
// 決済画面に進んだ時点で作る。PENDING の間（holdExpiresAt まで）は選んだ枠の席を確保し、
// PAID の Webhook で Registration（CONFIRMED）と Ticket を作る。FAILED / EXPIRED なら何も作らず席を解放する
// 期限切れの解放は、先に決済事業者側のセッションを失効させてから行う（Stripe なら checkout.sessions.expire）。
//   失効がエラーになったときは、セッションを取得して支払い状況を確認する。支払い済み（payment_status=paid）のときだけ PAID として確定し、
//   既に失効済み・未払いなら EXPIRED にする。解放後に支払い済みの通知が届き定員を超える場合は自動返金して本人に知らせる
// 同じ人・同じイベントで PENDING は1件だけ（末尾 SQL の部分一意インデックス）。決済をやり直すときは前の Payment を失効させてから作る
model Payment {
  id            String          @id @default(cuid())
  userId        String
  eventId       String
  slotIds       String[] // 申し込む枠（無料枠も含めて一緒に確定する）
  answersDraft  Json? // 確定までの回答。確定時に RegistrationAnswer へ移す。失敗時は再試行の Payment へ引き継ぎ、EXPIRED になったら消す
  provider      PaymentProvider
  providerRef   String          @unique // Webhook の冪等性
  amountYen     Int
  status        PaymentStatus   @default(PENDING)
  holdExpiresAt DateTime // 席の確保期限（Stripe Checkout の有効期限と合わせる）
  failureReason String?
  paidAt        DateTime?
  refundedAt    DateTime?
  createdAt     DateTime        @default(now())

  user          User           @relation(fields: [userId], references: [id])
  event         Event          @relation(fields: [eventId], references: [id])
  registrations Registration[]

  @@index([eventId, status, holdExpiresAt]) // 定員判定と期限切れ Cron
  @@index([userId])
}

// 実決済フェーズで有効化（Stripe Connect Standard 想定）
model PayoutAccount {
  id                String          @id @default(cuid())
  organizerId       String
  provider          PaymentProvider
  externalAccountId String
  label             String
  verifiedAt        DateTime?

  organizer Organizer @relation(fields: [organizerId], references: [id])
  events    Event[]

  @@index([organizerId])
}

// ---------- 告知・お気に入り・通報 ----------
model Announcement {
  id             String                 @id @default(cuid())
  eventId        String
  subject        String
  body           String
  audiences      AnnouncementAudience[] // 参加予定の人・保存した人（両方可）
  recipientCount Int
  sentAt         DateTime               @default(now())

  event         Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  notifications NotificationLog[]

  @@index([eventId, sentAt])
}

// イベントの保存（UI 名「保存」。旧「お気に入り」）。主催者は保存した人にもお知らせを送れる
model SavedEvent {
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([eventId])
}

// 通報（targetId は Event.id か Organizer.id。ポリモーフィックなので FK は張らない）
// 理由は必須。OTHER のときは detail も必須（アプリで検証）。受け付けたら NMJ 運営へ REPORT_RECEIVED を送る。項目は検討中
model Report {
  id             String           @id @default(cuid())
  reporterUserId String
  targetType     ReportTargetType
  targetId       String
  reason         ReportReason
  detail         String?
  status         ReportStatus     @default(OPEN)
  createdAt      DateTime         @default(now())
  resolvedAt     DateTime?
  resolvedById   String? // 対応した運営
  resolution     String?

  reporter   User  @relation(fields: [reporterUserId], references: [id])
  resolvedBy User? @relation("ReportResolvedBy", fields: [resolvedById], references: [id])

  @@index([targetType, targetId])
  @@index([status, createdAt])
}

// ---------- Media（自前 DB。運営と主催者が投稿、主催者投稿は運営が審査） ----------
model MediaArticle {
  id                String        @id @default(cuid())
  slug              String        @unique
  title             String
  lead              String?
  body              String
  category          String // 新歓ガイド / インタビュー / ノウハウ / 学園祭（体系は未決）
  coverUrl          String?
  readMinutes       Int?
  isFeatured        Boolean       @default(false)
  status            ArticleStatus @default(DRAFT)
  authorUserId      String // 書いた人
  authorOrganizerId String? // 主催者として投稿した場合。NULL = 運営記事
  reviewedById      String? // 審査した運営
  reviewedAt        DateTime?
  rejectReason      String?
  publishedAt       DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  author          User                    @relation("ArticleAuthor", fields: [authorUserId], references: [id])
  authorOrganizer Organizer?              @relation("ArticleAuthorOrganizer", fields: [authorOrganizerId], references: [id])
  reviewedBy      User?                   @relation("ArticleReviewer", fields: [reviewedById], references: [id])
  events          MediaArticleEvent[] // 関連イベント
  organizers      MediaArticleOrganizer[] // 記事に登場する主催者

  @@index([status, publishedAt])
  @@index([category, publishedAt])
  @@index([authorOrganizerId])
}

model MediaArticleEvent {
  articleId String
  eventId   String

  article MediaArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  event   Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([articleId, eventId])
}

model MediaArticleOrganizer {
  articleId   String
  organizerId String

  article   MediaArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  organizer Organizer    @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@id([articleId, organizerId])
}

// ---------- お知らせ（サイト内のお知らせ＋メール送信ログ）と配信停止 ----------
// サイト内のお知らせとして表示し、同じ内容をメールでも送る
model NotificationLog {
  id                String             @id @default(cuid())
  userId            String? // 宛先ユーザー（招待など未登録宛ては NULL）
  toEmail           String
  type              NotificationType
  title             String // お知らせ一覧に出す件名
  readAt            DateTime? // サイト内で既読にした日時
  status            NotificationStatus @default(QUEUED)
  eventId           String?
  registrationId    String?
  announcementId    String?
  providerMessageId String? // Resend のメッセージ ID
  error             String?
  createdAt         DateTime           @default(now())
  sentAt            DateTime?

  user         User?         @relation(fields: [userId], references: [id])
  event        Event?        @relation(fields: [eventId], references: [id])
  registration Registration? @relation(fields: [registrationId], references: [id])
  announcement Announcement? @relation(fields: [announcementId], references: [id])

  @@index([userId, createdAt])
  @@index([type, status])
  @@index([eventId])
}

// 配信停止（カテゴリ単位）。行が無ければ受信する。フォロー先ごとの ON/OFF は Follow.notifyEmail
model EmailPreference {
  userId    String
  category  EmailCategory
  enabled   Boolean       @default(true)
  updatedAt DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, category])
}

// ---------- Auth.js（@auth/prisma-adapter） ----------
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

